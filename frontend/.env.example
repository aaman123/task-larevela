# ─── API ─────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://api.larevela.com

# Optional: Bearer token (leave blank to use session-cookie auth)
# VITE_API_TOKEN=

# ─── Blockchain ───────────────────────────────────────────────────────────────
# Chain: 1 = Ethereum Mainnet | 11155111 = Sepolia Testnet
VITE_CHAIN_ID=11155111

# Fill in after deploying LaRevelaToken via `cd contracts && npm run deploy:sepolia`
# The deploy script will print: VITE_CONTRACT_ADDRESS=0x...
VITE_CONTRACT_ADDRESS=0xYourDeployedAddress